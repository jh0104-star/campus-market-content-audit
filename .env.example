# 复制为 .env 后填写；未配置时系统自动使用本地语义分析器（离线可完整演示）
# 仅两种引擎：mock（本地分析器） / deepseek（远程大模型）

LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
# DeepSeek 官方地址不带 /v1，已内置为预设，留空即可
# LLM_BASE_URL=https://api.deepseek.com

LLM_TIMEOUT=25
# 若模型常在 JSON 外附带多余文字，改为 1
LLM_JSON_MODE=0
